{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/dhilbarr/suade/schemas/sources.schema.json",
  "title": "Suade sources manifest",
  "description": "The upstream inputs a deck compiles from. sha256 enables recompile/diff staleness detection.",
  "type": "object",
  "required": ["version", "files"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "kind"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "kind": { "enum": ["notes", "metrics", "crm", "spec", "deck", "transcript", "financials", "other"] },
          "note": { "type": "string" }
        }
      }
    }
  }
}
