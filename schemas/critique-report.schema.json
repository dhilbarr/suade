{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/dhilbarr/suade/schemas/critique-report.schema.json",
  "title": "Suade critique report",
  "type": "object",
  "required": ["deck_ref", "audience", "verdict", "scores", "hard_fails", "findings", "top_fixes"],
  "additionalProperties": false,
  "properties": {
    "deck_ref": { "type": "string", "description": "Path or name of the critiqued deck" },
    "audience": { "type": "string", "description": "Lens id, e.g. yc-demo-day" },
    "audience_inferred": { "type": "boolean", "default": false },
    "created_at": { "type": "string" },
    "verdict": { "type": "string", "description": "2-3 sentence direct verdict incl. ready/not-ready for the room" },
    "acceptance_pass": { "type": "boolean" },
    "scores": {
      "type": "object",
      "required": ["content", "coherence", "differentiation"],
      "additionalProperties": false,
      "properties": {
        "content": { "$ref": "#/definitions/score" },
        "coherence": { "$ref": "#/definitions/score" },
        "differentiation": { "$ref": "#/definitions/score" }
      }
    },
    "spine": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slide", "role", "core_message", "grounding"],
        "additionalProperties": false,
        "properties": {
          "slide": { "type": "integer", "minimum": 1 },
          "role": { "$ref": "#/definitions/role" },
          "core_message": { "type": "string" },
          "grounding": { "enum": ["grounded", "partial", "missing"] }
        }
      }
    },
    "hard_fails": { "type": "array", "items": { "type": "string" } },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "category", "finding", "suggested_fix"],
        "additionalProperties": false,
        "properties": {
          "slide_anchor": { "type": "string", "description": "e.g. 's4' or 's4-s5'; omit only for deck-level findings" },
          "severity": { "enum": ["hard-fail", "major", "minor"] },
          "category": {
            "enum": [
              "uncited-metric",
              "missing-evidence",
              "one-idea-violation",
              "missing-ask",
              "spine-break",
              "duplicated-claim",
              "earn-violation",
              "audience-objection",
              "role-mismatch",
              "stale-claim",
              "other"
            ]
          },
          "finding": { "type": "string" },
          "suggested_fix": { "type": "string" },
          "pattern_refs": { "type": "array", "items": { "$ref": "#/definitions/patternRef" } }
        }
      }
    },
    "top_fixes": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["fix", "why_this_room_cares"],
        "additionalProperties": false,
        "properties": {
          "slide_anchor": { "type": "string" },
          "fix": { "type": "string" },
          "why_this_room_cares": { "type": "string" },
          "pattern_refs": { "type": "array", "items": { "$ref": "#/definitions/patternRef" } }
        }
      }
    },
    "delta": {
      "type": "object",
      "description": "Present only in --recheck mode",
      "additionalProperties": false,
      "properties": {
        "resolved": { "type": "array", "items": { "type": "string" } },
        "persisting": { "type": "array", "items": { "type": "string" } },
        "regressed": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ingestion_notes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": { "type": "string" },
        "slides_total": { "type": "integer" },
        "unreadable_slides": { "type": "array", "items": { "type": "integer" } },
        "limitations": { "type": "string" }
      }
    }
  },
  "definitions": {
    "score": {
      "type": "object",
      "required": ["value", "why"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "integer", "minimum": 1, "maximum": 5 },
        "why": { "type": "string" }
      }
    },
    "role": {
      "enum": ["hook", "problem", "why_now", "solution", "product", "market", "traction", "business_model", "gtm", "moat", "competition", "team", "financials", "ask", "vision", "appendix", "other"]
    },
    "patternRef": {
      "type": "object",
      "required": ["id", "why"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+#s[0-9]{3}$" },
        "why": { "type": "string" }
      }
    }
  }
}
