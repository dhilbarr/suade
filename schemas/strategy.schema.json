{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/dhilbarr/suade/schemas/strategy.schema.json",
  "title": "Suade selected narrative strategy",
  "description": "One strategy selected before any slide exists. Exemplar refs cite pattern-corpus record ids so the choice is inspectable.",
  "type": "object",
  "required": ["strategy_id", "audience", "name", "narrative_theme", "summary", "reasoning", "ordered_slide_roles"],
  "additionalProperties": false,
  "properties": {
    "strategy_id": { "type": "string", "minLength": 1 },
    "audience": { "$ref": "defs.schema.json#/definitions/audience" },
    "name": { "type": "string", "minLength": 1 },
    "narrative_theme": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "reasoning": { "type": "string", "minLength": 1 },
    "exemplar_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "why"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "defs.schema.json#/definitions/pattern_id" },
          "why": { "type": "string", "minLength": 1 }
        }
      }
    },
    "ordered_slide_roles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "defs.schema.json#/definitions/role" }
    },
    "emphasis": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "alternatives_considered": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "why_not"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "why_not": { "type": "string", "minLength": 1 }
        }
      }
    },
    "created_at": { "type": "string" }
  }
}
