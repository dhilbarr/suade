{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/dhilbarr/suade/schemas/delivery-plan.schema.json",
  "title": "Suade delivery plan",
  "description": "Rehearse step 1 (no camera): per-slide time budgets, pause cues, emphasis, speaker notes. Direct port of the v1 architecture doc §12 DeliveryPlan type.",
  "type": "object",
  "required": ["deck_ref", "audience", "slides"],
  "additionalProperties": false,
  "properties": {
    "deck_ref": { "type": "string", "minLength": 1 },
    "audience": { "$ref": "defs.schema.json#/definitions/audience" },
    "total_target_duration_sec": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string" },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["n", "target_duration_sec", "emphasis_points", "tone"],
        "additionalProperties": false,
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "target_duration_sec": { "type": "integer", "minimum": 1 },
          "emphasis_points": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "speaker_note_draft": { "type": "string" },
          "pause_cues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["duration_ms", "reason"],
              "additionalProperties": false,
              "properties": {
                "after_text": { "type": "string" },
                "duration_ms": { "type": "integer", "minimum": 100 },
                "reason": { "type": "string", "minLength": 1 }
              }
            }
          },
          "transition_note": { "type": "string" },
          "tone": { "$ref": "defs.schema.json#/definitions/tone" }
        }
      }
    }
  }
}
